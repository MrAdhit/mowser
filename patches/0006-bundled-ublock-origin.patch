+# Copyright 2026 The Mowser Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# uBlock Origin, which ComponentLoader::AddUBlockOrigin() loads. scripts/ubo.sh
+# writes ublock_origin.zip before the build.
+
+if (is_android) {
+  import("//build/config/android/rules.gni")
+
+  # Stored uncompressed so that base::android::OpenApkAsset() can read it.
+  android_assets("ublock_origin_assets") {
+    sources = [ "ublock_origin.zip" ]
+    disable_compression = true
+  }
+} else if (is_mac) {
+  # Copied into the framework bundle's Resources, which is base::DIR_ASSETS.
+  bundle_data("ublock_origin_bundle_data") {
+    sources = [ "ublock_origin.zip" ]
+    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+  }
+} else {
+  # Copied next to the executable, which is base::DIR_ASSETS.
+  copy("ublock_origin") {
+    sources = [ "ublock_origin.zip" ]
+    outputs = [ "$root_out_dir/{{source_file_part}}" ]
+  }
+}
