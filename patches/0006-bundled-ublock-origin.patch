+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// Unpacks the APK asset assets/ublock_origin.zip into `dir` unless `dir`
+// already holds that zip's contents, as recorded in a stamp file holding a hash
+// of the zip, then loads and localizes the extension's manifest. Returns the
+// manifest, or nullopt on failure.
+std::optional<base::DictValue> UnpackUBlockOrigin(const base::FilePath& dir) {
+  base::MemoryMappedFile::Region region;
+  base::File asset(
+      base::android::OpenApkAsset("assets/ublock_origin.zip", &region));
+  if (!asset.IsValid()) {
+    LOG(ERROR) << "uBlock Origin is missing from the APK";
+    return std::nullopt;
+  }
+  std::vector<uint8_t> zip(region.size);
+  if (!asset.ReadAndCheck(region.offset, zip)) {
+    LOG(ERROR) << "Failed to read uBlock Origin from the APK";
+    return std::nullopt;
+  }
+
+  const base::FilePath stamp_path = dir.Append(FILE_PATH_LITERAL(".bundle"));
+  const std::string stamp = base::NumberToString(base::PersistentHash(zip));
+  std::string current_stamp;
+  if (!base::ReadFileToString(stamp_path, &current_stamp) ||
+      current_stamp != stamp) {
+    base::ScopedTempFile zip_file;
+    if (!zip_file.Create() || !base::WriteFile(zip_file.path(), zip) ||
+        !base::DeletePathRecursively(dir) || !base::CreateDirectory(dir) ||
+        !zip::Unzip(zip_file.path(), dir) ||
+        !base::WriteFile(stamp_path, stamp)) {
+      LOG(ERROR) << "Failed to unpack uBlock Origin into " << dir;
+      base::DeletePathRecursively(dir);
+      return std::nullopt;
+    }
+  }
+
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(dir, &error);
+  if (!manifest ||
+      !extension_l10n_util::LocalizeExtension(
+          dir, &manifest.value(),
+          extension_l10n_util::GzippedMessagesPermission::kDisallow, &error)) {
+    LOG(ERROR) << "Failed to load uBlock Origin: " << error;
+    return std::nullopt;
+  }
+  return manifest;
+}
+
+}  // namespace
+
+void ComponentLoader::AddUBlockOrigin() {
+  const base::FilePath dir =
+      profile_->GetPath().Append(FILE_PATH_LITERAL("uBlock Origin"));
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&UnpackUBlockOrigin, dir),
+      base::BindOnce(
+          [](base::WeakPtr<ComponentLoader> loader, const base::FilePath& dir,
+             std::optional<base::DictValue> manifest) {
+            if (loader && manifest) {
+              loader->Add(std::move(*manifest), dir);
+            }
+          },
+          weak_factory_.GetWeakPtr(), dir));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
